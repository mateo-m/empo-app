---
import { Font } from "astro:assets";
import "../landing/style.css";
import demo from "../landing/media/demo-cinematic.png";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const origin = new URL(base, Astro.site).href;
const description = "Empo runs RPG Maker XP, VX, and VX Ace games, and Pokemon Essentials games, on iPhone and iPad.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Empo. RPG Maker games on your iPhone.</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="oklch(0.199 0.059 268.9)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Empo" />
    <meta property="og:url" content={origin} />
    <meta property="og:title" content="Empo. RPG Maker games on your iPhone." />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${origin}share.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Empo sailboat and name over a pixel sea, next to an iPhone that runs an RPG Maker game." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Empo. RPG Maker games on your iPhone." />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${origin}share.png`} />
    <meta name="twitter:image:alt" content="The Empo sailboat and name over a pixel sea, next to an iPhone that runs an RPG Maker game." />
    <link rel="canonical" href={origin} />
    <link rel="icon" href={`${base}icon.png`} />
    <Font cssVariable="--blume-ff-nunito" preload />
  </head>
  <body class="group/page intro h-svh overflow-hidden">
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden transition-[opacity,filter] duration-1200 ease-spring group-[.intro]/page:opacity-0 group-[.intro]/page:blur-sm motion-reduce:transition-none" aria-hidden="true">
      <div class="stars absolute inset-0 opacity-60" data-depth="-1"></div>
      <div class="horizon absolute inset-x-0 bottom-0 top-[calc(var(--waterline,50svh)-24*var(--unit))]"></div>
      <div class="parallax absolute top-[7%] right-[10%] size-[calc(16*var(--unit))] md:top-[10%] md:right-auto md:left-[44%]" data-depth="-2"><div class="moon size-full"></div></div>
      <div class="parallax pixel clouds-back absolute -inset-x-8 h-[calc(24*var(--unit))] opacity-30 top-[calc(var(--waterline,50svh)-52*var(--unit))] motion-reduce:animate-none" data-depth="-8"></div>
      <div class="parallax pixel clouds-front absolute -inset-x-8 h-[calc(24*var(--unit))] opacity-45 top-[calc(var(--waterline,50svh)-40*var(--unit))] motion-reduce:animate-none" data-depth="-5"></div>
      <div class="parallax absolute -inset-x-8 -bottom-6 top-[calc(var(--waterline,50svh)-7*var(--unit))]" data-depth="-3">
        <div class="pixel band-far size-full transition-[translate,opacity,filter] duration-1200 ease-spring group-[.intro]/page:translate-y-[calc(8*var(--unit))] group-[.intro]/page:opacity-0 group-[.intro]/page:blur-sm motion-reduce:transition-none motion-reduce:animate-none"></div>
      </div>
    </div>

    <main class="mx-auto grid h-svh max-w-6xl grid-rows-[1fr_auto_1.5fr] items-center space-y-5 px-6 py-6 md:grid-cols-[1fr_auto] md:grid-rows-[1fr_1fr] md:space-y-0 md:px-12">
      <div class="tilt relative z-20 hidden min-h-0 justify-self-center self-center animate-rise md:block [animation-delay:300ms] motion-reduce:animate-none md:col-start-2 md:row-span-2 md:row-start-1 md:ml-20 md:h-[min(84svh,760px)]" data-reveal data-tilt>
        <div class="mx-auto aspect-[1206/2622] h-full rounded-[44px] border-2 border-white/15 bg-[oklch(0.199_0.059_268.9)] p-2.5 transition-[scale,border-color] duration-300 ease-snappy hover:scale-[1.02] hover:border-brand/60 motion-reduce:transition-none">
          <img class="block size-full rounded-[34px] object-cover" src={demo.src} alt="A cinematic scene from an RPG Maker game running in Empo." width="1206" height="2622" />
        </div>
      </div>

      <h1 class="flex items-center justify-center space-x-[0.08em] text-[length:calc(var(--unit)*25)] leading-none font-black tracking-[-0.05em] text-shadow-wii self-center row-start-2 md:col-start-1 md:row-start-1 md:justify-start md:self-end" data-lockup>
        <svg class="boat relative z-[5] size-[0.72em] shrink-0 fill-brand [visibility:hidden] motion-reduce:[visibility:visible] group-[.afloat]/page:animate-bob motion-reduce:group-[.afloat]/page:animate-none" viewBox="0 0 1024.5 1024.5" aria-hidden="true" data-boat><use href="#empo-mark" /></svg>
        <span class="relative z-20 inline-flex" aria-label="Empo"><span class="animate-rise [animation-delay:250ms] motion-reduce:animate-none" aria-hidden="true" data-reveal>E</span><span class="animate-rise [animation-delay:320ms] motion-reduce:animate-none" aria-hidden="true" data-reveal>m</span><span class="animate-rise [animation-delay:390ms] motion-reduce:animate-none" aria-hidden="true" data-reveal>p</span><span class="animate-rise [animation-delay:460ms] motion-reduce:animate-none" aria-hidden="true" data-reveal>o</span></span>
      </h1>

      <div class="relative z-20 flex flex-col items-center space-y-5 self-start pt-6 text-center row-start-3 md:col-start-1 md:row-start-2 md:items-start md:space-y-6 md:pt-10 md:text-left">
        <p class="text-lg text-white/80 text-shadow-wii animate-rise [animation-delay:520ms] motion-reduce:animate-none md:text-xl" data-reveal>RPG Maker games on your iPhone.</p>
        <ul class="menu flex flex-col items-center md:pl-7 text-lg font-black text-shadow-wii md:items-start md:text-xl" aria-label="Menu">
          <li class="animate-rise [animation-delay:600ms] motion-reduce:animate-none" data-reveal><a class="py-0.5 text-brand md:py-1.5" href="https://github.com/mateo-m/empo-app/releases"><span class="cursor"><svg class="size-4 px fill-brand" viewBox="0 0 16 16" aria-hidden="true"><use href="#px-diamond" /></svg></span>Download the IPA</a></li>
          <li class="animate-rise [animation-delay:660ms] motion-reduce:animate-none" data-reveal><a class="py-0.5 text-white/80 md:py-1.5" href={`${base}install`}><span class="cursor"><svg class="size-4 px fill-brand" viewBox="0 0 16 16" aria-hidden="true"><use href="#px-diamond" /></svg></span>How to install</a></li>
          <li class="animate-rise [animation-delay:720ms] motion-reduce:animate-none" data-reveal><a class="py-0.5 text-white/80 md:py-1.5" href={`${base}introduction`}><span class="cursor"><svg class="size-4 px fill-brand" viewBox="0 0 16 16" aria-hidden="true"><use href="#px-diamond" /></svg></span>Docs</a></li>
          <li class="animate-rise [animation-delay:780ms] motion-reduce:animate-none" data-reveal><a class="py-0.5 text-white/80 md:py-1.5" href="https://github.com/mateo-m/empo-app"><span class="cursor"><svg class="size-4 px fill-brand" viewBox="0 0 16 16" aria-hidden="true"><use href="#px-diamond" /></svg></span>GitHub</a></li>
          <li class="animate-rise [animation-delay:840ms] motion-reduce:animate-none" data-reveal><a class="py-0.5 text-white/80 md:py-1.5" href="https://discord.gg/m3YnpXMxrB"><span class="cursor"><svg class="size-4 px fill-brand" viewBox="0 0 16 16" aria-hidden="true"><use href="#px-diamond" /></svg></span>Discord</a></li>
        </ul>
      </div>
    </main>

    <div class="pointer-events-none fixed inset-0 z-10" aria-hidden="true">
      <div class="parallax absolute -inset-x-8 -bottom-6 top-[calc(var(--waterline,50svh)-4*var(--unit))]" data-depth="4">
        <div class="pixel band-near size-full opacity-95 transition-[translate,opacity,filter] duration-1200 ease-spring group-[.intro]/page:translate-y-[calc(8*var(--unit))] group-[.intro]/page:opacity-0 group-[.intro]/page:blur-sm motion-reduce:transition-none motion-reduce:animate-none"></div>
      </div>
      <div class="parallax absolute -inset-x-8 -bottom-6 top-[calc(var(--waterline,50svh)+8*var(--unit))]" data-depth="9">
        <div class="pixel band-mid size-full opacity-90 transition-[translate,opacity,filter] duration-1200 ease-spring group-[.intro]/page:translate-y-[calc(8*var(--unit))] group-[.intro]/page:opacity-0 group-[.intro]/page:blur-sm motion-reduce:transition-none motion-reduce:animate-none"></div>
      </div>
      <div class="parallax absolute -inset-x-8 -bottom-6 top-[calc(var(--waterline,50svh)+21*var(--unit))]" data-depth="14">
        <div class="pixel band-front size-full opacity-90 transition-[translate,opacity,filter] duration-1200 ease-spring group-[.intro]/page:translate-y-[calc(8*var(--unit))] group-[.intro]/page:opacity-0 group-[.intro]/page:blur-sm motion-reduce:transition-none motion-reduce:animate-none"></div>
      </div>
      <div class="parallax absolute -inset-x-8 h-[calc(24*var(--unit))] bottom-[18svh] opacity-70 md:top-[calc(var(--waterline,50svh)+26*var(--unit))] md:bottom-auto" data-depth="12"><div class="pixel fish size-full transition-[opacity,filter] duration-1200 ease-spring group-[.intro]/page:opacity-0 group-[.intro]/page:blur-sm motion-reduce:animate-none"></div></div>
      <div class="parallax absolute -inset-x-8 -bottom-6 h-[calc(64*var(--unit))] opacity-35" data-depth="17"><div class="bubbles size-full transition-[opacity,filter] duration-1200 ease-spring group-[.intro]/page:opacity-0 group-[.intro]/page:blur-sm motion-reduce:animate-none"></div></div>
      <div class="parallax absolute -inset-x-8 -bottom-6 h-[calc(34svh+24px)]" data-depth="20">
        <div class="pixel seabed size-full transition-[translate,opacity,filter] duration-1200 ease-spring group-[.intro]/page:translate-y-[calc(8*var(--unit))] group-[.intro]/page:opacity-0 group-[.intro]/page:blur-sm motion-reduce:transition-none"></div>
      </div>
    </div>
    <footer class="fixed inset-x-0 bottom-0 z-20 hidden px-6 pb-4 text-center text-xs text-white/40 animate-rise [animation-delay:900ms] motion-reduce:animate-none md:block" data-reveal>GPLv2+ · Sideload with AltStore or SideStore · iOS 26 or newer · <a class="transition-colors hover:text-white" href={`${base}privacy`}>Privacy</a> · <a class="transition-colors hover:text-white" href={`${base}terms`}>Terms</a></footer>
    <svg width="0" height="0" style="position: absolute" aria-hidden="true">
      <defs>
        <g id="empo-mark">
          <polygon points="882.02 284.69 882.02 227.81 825.14 227.81 825.14 170.92 768.25 170.92 768.25 114.03 711.36 114.03 711.36 57.15 654.47 57.15 597.58 57.15 597.58 .25 540.69 .25 540.69 57.15 540.69 114.03 540.69 170.92 540.69 227.81 540.69 284.69 540.69 341.59 540.69 398.48 540.69 455.36 540.69 512.25 540.69 569.14 540.69 626.02 540.69 682.92 597.58 682.92 597.58 626.02 654.47 626.02 711.36 626.02 768.25 626.02 825.14 626.02 825.14 682.92 882.02 682.92 882.02 626.02 882.02 569.14 938.91 569.14 938.91 512.25 938.91 455.36 938.91 398.48 938.91 341.59 938.91 284.69 882.02 284.69" />
          <polygon points="825.14 739.81 768.25 739.81 768.25 796.69 711.36 796.69 654.47 796.69 597.58 796.69 540.69 796.69 483.81 796.69 426.92 796.69 426.92 739.81 370.03 739.81 313.14 739.81 256.25 739.81 199.36 739.81 142.48 739.81 142.48 796.69 199.36 796.69 199.36 853.58 199.36 910.47 256.25 910.47 256.25 967.36 313.14 967.36 370.03 967.36 370.03 1024.25 426.92 1024.25 483.81 1024.25 540.69 1024.25 597.58 1024.25 654.47 1024.25 654.47 967.36 711.36 967.36 768.25 967.36 768.25 910.47 825.14 910.47 825.14 853.58 882.02 853.58 882.02 796.69 938.91 796.69 938.91 739.81 882.02 739.81 825.14 739.81" />
          <polygon points="199.36 682.92 256.25 682.92 313.14 682.92 370.03 682.92 426.92 682.92 483.81 682.92 483.81 626.02 483.81 569.14 483.81 512.25 483.81 455.36 483.81 398.48 483.81 341.59 483.81 284.69 483.81 227.81 483.81 170.92 483.81 114.03 426.92 114.03 426.92 170.92 426.92 227.81 370.03 227.81 370.03 284.69 370.03 341.59 313.14 341.59 313.14 398.48 313.14 455.36 256.25 455.36 256.25 512.25 199.36 512.25 199.36 569.14 142.48 569.14 142.48 626.02 85.59 626.02 85.59 682.92 142.48 682.92 199.36 682.92" />
        </g>
        <path id="px-circle" d="M12 16H4V14H12V16ZM4 14H2V12H4V14ZM14 14H12V12H14V14ZM2 12H0V4H2V12ZM16 12H14V4H16V12ZM4 4H2V2H4V4ZM14 4H12V2H14V4ZM12 2H4V0H12V2Z" />
        <path id="px-square" d="M14 2H2V14H14V2ZM16 16H0V0H16V16Z" />
        <path id="px-square-rounded" d="M14 16H2V14H14V16ZM2 14H0V2H2V14ZM16 14H14V2H16V14ZM14 2H2V0H14V2Z" />
        <path id="px-diamond" d="M10 2H12V4H14V6H16V10H14V12H12V14H10V16H6V14H4V12H2V10H0V6H2V4H4V2H6V0H10V2Z" />
        <path id="px-heart" d="M4 2H6V4H10V2H12V0H14V2H16V10H14V12H12V14H10V16H6V14H4V12H2V10H0V2H2V0H4V2Z" />
        <path id="px-star" d="M4 16H2V14H4V16ZM14 16H12V14H14V16ZM10 4H12V6H16V8H14V10H12V14H10V12H6V14H4V10H2V8H0V6H4V4H6V0H10V4Z" />
        <path id="px-plus" d="M10 6H16V10H10V16H6V10H0V6H6V0H10V6Z" />
        <path id="px-cube" d="M2 6H10V14H12V16H0V4H2V6ZM16 12H14V14H12V4H14V2H12V4H2V2H4V0H16V12Z" />
        <path id="px-sphere" d="M14 6H12V10H14V6ZM10 6H12V4H10V6ZM6 4H10V2H6V4ZM16 12H14V14H12V16H4V14H2V12H0V4H2V2H4V0H12V2H14V4H16V12Z" />
      </defs>
    </svg>
    <script src="../landing/main.js"></script>
  </body>
</html>
