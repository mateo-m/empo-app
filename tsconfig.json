{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "types": [
      "bun"
    ]
  },
  "include": [
    "scripts/**/*.ts",
    "tools/**/*.ts"
  ]
}
