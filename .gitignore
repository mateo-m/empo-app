# Games (large, user-provided content)
demo/

# Build artifacts
.build/
ios/Empo/build/
ios/Empo/Empo.xcodeproj/
*.ipa

# Docs site (Blume generates .blume/ and builds into dist/)
# tools/changelog-page.ts derives this page from CHANGELOG.md.
docs/changelog.mdx
# tools/root-pages.ts derives these pages from the root markdown files.
docs/privacy.mdx
docs/terms.mdx
docs/community.mdx
.blume/
dist/

# Dependencies (downloaded sources and build outputs)
ios/Dependencies/downloads/
ios/Dependencies/build-*/

# ANGLE prebuilt - hydrated at build time by tools/fetch-angle.sh
# from a tagged release on github.com/mateo-m/empo-deps. The binaries
# are too large for git (~80 MB) and version-pinned via
# ios/Dependencies/ANGLE/.version (which IS tracked).
ios/Dependencies/ANGLE/iphoneos/include/
ios/Dependencies/ANGLE/iphoneos/lib/
ios/Dependencies/ANGLE/iphonesimulator/include/
ios/Dependencies/ANGLE/iphonesimulator/lib/
ios/Dependencies/ANGLE/.fetched-version

# The mkxp-z core release, fetched by tools/fetch-mkxp-core.sh.
# Version-pinned via ios/Dependencies/mkxp/.version (tracked).
ios/Dependencies/mkxp-core/
ios/Dependencies/mkxp-core.*

# The engine history that tools/changelog-page.ts reads.
.engine-history/

# The PSDK core release, fetched by tools/fetch-psdk-core.sh.
# Version-pinned via ios/Dependencies/psdk/.version (tracked).
ios/Dependencies/psdk-core/
ios/Dependencies/psdk-core.*

# The MV/MZ core release, fetched by tools/fetch-mvmz-core.sh.
# Version-pinned via ios/Dependencies/mvmz/.version (tracked).
ios/Dependencies/mvmz-core/
ios/Dependencies/mvmz-core.*

# MetalANGLE.xcframework - unreferenced by the build, kept untracked
# in case anything ever needs it. Currently not in the working tree.
ios/Dependencies/Frameworks/

# Xcode / DerivedData
DerivedData/
ios/Empo/.derivedData/
*.xcworkspace
xcuserdata/

# Clangd / LSP cache
.cache/
compile_commands.json

# macOS
.DS_Store
**/.DS_Store

# Temporary files
*.swp
*.swo
*~
ios/Empo/src/App/GitInfo.generated.swift

*.md
!/docs/**/*.md
!/ios/**/*.md
!/CHANGELOG.md
!/README.md
!/CONTRIBUTING.md
!/PRIVACY.md
!/TERMS.md
!/SUPPORT.md

# Python cache (agent skill scripts)
__pycache__/
*.pyc

# Per-contributor code signing config (see Signing.xcconfig.example)
ios/Empo/Signing.xcconfig

# Assets.bundle is assembled at build time.
# Only .gitkeep is tracked to preserve the directory.
ios/Empo/Assets.bundle/*
!ios/Empo/Assets.bundle/.gitkeep

# Node tool caches (CI uses bun + bun.lock instead).
node_modules/

# Build outputs (xcodebuild derived data, IPA artifacts).
build/

# Root-level local object files from ad-hoc builds
/*.o
.blume-verify/
