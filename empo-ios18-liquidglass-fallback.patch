+            case .secondary:
+                content.legacyGlassFallback(
+                    in: Circle(), tint: .brand.opacity(Alpha.brandTintBackground))
+            case .outline:
+                content.legacyGlassFallback(in: Circle())
+            }
         }
     }
 }
