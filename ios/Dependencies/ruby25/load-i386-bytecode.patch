+/* In the bytecode of a 32-bit Ruby, VALUE, ID, long, and pointers have
+ * 4 bytes, so each field of those types has 4 bytes in the file. */
+static int32_t
+ibf_f32(const struct ibf_load *load, ibf_offset_t offset)
+{
+    int32_t v;
+    memcpy(&v, load->buff + offset, 4);
+    return v;
+}
 
+#define IBF_F32_OBJ(offset, n) ibf_f32(load, (offset) + (ibf_offset_t)sizeof(struct ibf_object_header) + (n))
+
+static VALUE
+ibf_f32_special_const(uint32_t v)
+{
+    /* 32-bit Ruby has no flonum: Qfalse=0 Qtrue=2 Qnil=4 Qundef=6 */
+    if (v & 1) return (VALUE)(SIGNED_VALUE)(int32_t)v;
+    switch (v) {
+      case 0: return Qfalse;
+      case 2: return Qtrue;
+      case 4: return Qnil;
+      case 6: return Qundef;
+    }
+    rb_raise(rb_eRuntimeError, "unknown 32-bit special constant: %x", v);
+}
