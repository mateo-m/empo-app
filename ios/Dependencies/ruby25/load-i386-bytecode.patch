+/* A 32-bit rb_call_info has 12 bytes: mid, flag, orig_argc. The entry
+ * with keywords adds 4 bytes for the kw_arg offset. */
+static struct rb_call_info *
+ibf_load_ci_entries_foreign32(const struct ibf_load *load, const struct rb_iseq_constant_body *body)
+{
+    unsigned int i;
+    const unsigned int ci_size = body->ci_size;
+    const unsigned int ci_kw_size = body->ci_kw_size;
+    const ibf_offset_t offset = IBF_OFFSET(body->ci_entries);
+    struct rb_call_info *ci_entries = ruby_xmalloc(sizeof(struct rb_call_info) * ci_size +
+						   sizeof(struct rb_call_info_with_kwarg) * ci_kw_size);
+    struct rb_call_info_with_kwarg *ci_kw_entries = (struct rb_call_info_with_kwarg *)&ci_entries[ci_size];
+
+    for (i=0; i<ci_size; i++) {
+	const ibf_offset_t entry = offset + i * 12;
+	ci_entries[i].mid = ibf_load_id(load, (ID)(uint32_t)ibf_f32(load, entry));
+	ci_entries[i].flag = (unsigned int)ibf_f32(load, entry + 4);
+	ci_entries[i].orig_argc = ibf_f32(load, entry + 8);
+    }
+    for (i=0; i<ci_kw_size; i++) {
+	const ibf_offset_t entry = offset + ci_size * 12 + i * 16;
+	const ibf_offset_t kw_arg_offset = (ibf_offset_t)ibf_f32(load, entry + 12);
+	const int keyword_len = ibf_f32(load, kw_arg_offset);
+	struct rb_call_info_kw_arg *kw_arg = ruby_xmalloc(sizeof(struct rb_call_info_kw_arg) + sizeof(VALUE) * (keyword_len - 1));
+	int j;
+
+	kw_arg->keyword_len = keyword_len;
+	for (j=0; j<keyword_len; j++) {
+	    kw_arg->keywords[j] = ibf_load_object(load, (VALUE)(uint32_t)ibf_f32(load, kw_arg_offset + 4 + j * 4));
+	}
+	ci_kw_entries[i].kw_arg = kw_arg;
+	ci_kw_entries[i].ci.mid = ibf_load_id(load, (ID)(uint32_t)ibf_f32(load, entry));
+	ci_kw_entries[i].ci.flag = (unsigned int)ibf_f32(load, entry + 4);
+	ci_kw_entries[i].ci.orig_argc = ibf_f32(load, entry + 8);
+    }
+    return ci_entries;
