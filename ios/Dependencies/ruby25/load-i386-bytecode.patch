+/* The 32-bit rb_iseq_constant_body has 144 bytes. Its pointer fields hold
+ * file offsets, and parent_iseq and local_iseq hold iseq indexes. */
+static void
+ibf_load_foreign32_body(const struct ibf_load *load, ibf_offset_t o, struct rb_iseq_constant_body *b)
+{
+#define F32(n) ibf_f32(load, o + (n))
+#define F32P(n) ((void *)(VALUE)(SIGNED_VALUE)F32(n))
+    MEMZERO(b, struct rb_iseq_constant_body, 1);
+    b->type = (enum iseq_type)F32(0);
+    b->iseq_size = (unsigned int)F32(4);
+    b->iseq_encoded = F32P(8);
+    memcpy(&b->param.flags, load->buff + o + 12, 4);
+    b->param.size = (unsigned int)F32(16);
+    b->param.lead_num = F32(20);
+    b->param.opt_num = F32(24);
+    b->param.rest_start = F32(28);
+    b->param.post_start = F32(32);
+    b->param.post_num = F32(36);
+    b->param.block_start = F32(40);
+    b->param.opt_table = F32P(44);
+    b->param.keyword = F32P(48);
+    b->location.pathobj = (VALUE)(uint32_t)F32(52);
+    b->location.base_label = (VALUE)(uint32_t)F32(56);
+    b->location.label = (VALUE)(uint32_t)F32(60);
+    b->location.first_lineno = (VALUE)(SIGNED_VALUE)F32(64); /* a Fixnum */
+    b->location.code_range.first_loc.lineno = F32(68);
+    b->location.code_range.first_loc.column = F32(72);
+    b->location.code_range.last_loc.lineno = F32(76);
+    b->location.code_range.last_loc.column = F32(80);
+    b->insns_info = F32P(84);
+    b->local_table = F32P(88);
+    b->catch_table = F32P(92);
+    b->parent_iseq = F32P(96);
+    b->local_iseq = F32P(100);
+    b->ci_entries = F32P(108);
+    b->mark_ary = (VALUE)(uint32_t)F32(116); /* the flip count */
+    b->local_table_size = (unsigned int)F32(120);
+    b->is_size = (unsigned int)F32(124);
+    b->ci_size = (unsigned int)F32(128);
+    b->ci_kw_size = (unsigned int)F32(132);
+    b->insns_info_size = (unsigned int)F32(136);
+    b->stack_max = (unsigned int)F32(140);
+#undef F32P
+#undef F32
+}
