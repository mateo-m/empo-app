+static VALUE
+ibf_foreign32_special_const(VALUE v)
+{
+    /* 32-bit Ruby has no flonum: Qfalse=0 Qtrue=2 Qnil=4 Qundef=6 */
+    if (v & 1) return v; /* fixnum, already sign-extended */
+    switch (v) {
+      case 0: return Qfalse;
+      case 2: return Qtrue;
+      case 4: return Qnil;
+      case 6: return Qundef;
+    }
+    rb_raise(rb_eRuntimeError, "unknown 32-bit special constant: %"PRIxVALUE, v);
+}
