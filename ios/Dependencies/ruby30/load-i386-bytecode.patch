+/*
+ * Ruby 3.0.3 added one field (outer_variables) to each iseq body and kept the
+ * format version, so the header does not tell the two layouts apart.
+ * The dumper writes the bodies in list order, then zero padding to a 4-byte
+ * boundary, then the iseq offset list. The first byte of a small value is
+ * never zero in a 32-bit file. So exactly one field count makes the last body
+ * end at the padding.
+ */
+static int
+ibf_foreign32_body_ends_at_list_p(const struct ibf_load *load, int field_count)
+{
+    const unsigned char *buff = (const unsigned char *)load->global_buffer.buff;
+    const ibf_offset_t list_offset = load->header->iseq_list_offset;
+    const ibf_offset_t *offsets = (const ibf_offset_t *)(buff + list_offset);
+    ibf_offset_t pos;
+    int i;
+
+    if (load->header->iseq_list_size == 0) return 0;
+    pos = offsets[load->header->iseq_list_size - 1];
+    for (i = 0; i < field_count; i++) {
+        if (pos >= list_offset) return 0;
+        (void)ibf_load_small_value(load, &pos);
+    }
+    if (pos > list_offset || list_offset - pos >= sizeof(ibf_offset_t)) return 0;
+    for (; pos < list_offset; pos++) {
+        if (buff[pos] != 0) return 0;
+    }
+    return 1;
+}
+
+static int
+ibf_foreign32_pre_303_p(const struct ibf_load *load)
+{
+    enum { fields_pre_303 = 39, fields_303 = 40 };
+
+    if (ibf_foreign32_body_ends_at_list_p(load, fields_303)) return 0;
+    if (ibf_foreign32_body_ends_at_list_p(load, fields_pre_303)) return 1;
+    rb_raise(rb_eRuntimeError, "unknown Ruby 3.0 iseq body layout");
+}
