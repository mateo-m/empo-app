    "See the game cores built into Empo in Settings." : {
      "comment" : "Text of an item in the What's new sheet after an update.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh dir die eingebauten Spielkerne von Empo in den Einstellungen an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira en Ajustes los núcleos que trae Empo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrouve les cœurs de jeu intégrés à Empo dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trovi i core di gioco inclusi in Empo nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empoに入っているゲームコアは「設定」で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo에 들어 있는 게임 코어를 설정에서 확인해 보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja os núcleos de jogo do Empo em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посмотрите встроенные в Empo игровые ядра в настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”中查看 Empo 内置的游戏核心。"
          }
        }
      }
    },
    "Some RPG Maker XP games that stopped at launch, such as Vinemon, now start." : {
      "comment" : "Text of an item in the What's new sheet after an update.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige RPG-Maker-XP-Spiele, die beim Start hängen blieben, wie Vinemon, starten jetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos juegos de RPG Maker XP que se detenían al abrirse, como Vinemon, ahora arrancan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains jeux RPG Maker XP qui s'arrêtaient au lancement, comme Vinemon, démarrent maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni giochi RPG Maker XP che si bloccavano all'avvio, come Vinemon, ora partono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinemonなど、起動時に止まっていたRPG Maker XPのゲームの一部が起動するようになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinemon처럼 실행하자마자 멈추던 일부 RPG Maker XP 게임이 이제 시작돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns jogos de RPG Maker XP que paravam ao abrir, como Vinemon, agora abrem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые игры на RPG Maker XP, которые зависали при запуске, например Vinemon, теперь запускаются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一些之前启动就卡住的 RPG Maker XP 游戏（比如 Vinemon）现在能正常启动了。"
          }
        }
      }
    },
    "Turn on \"Respect silent mode\" in Settings, and games stay quiet when your device is in silent mode." : {
      "comment" : "Text of an item in the What's new sheet after an update.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte „Stummmodus beachten“ in den Einstellungen ein, dann bleiben Spiele leise, wenn dein Gerät im Stummmodus ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa «Respetar el modo silencio» en Ajustes y los juegos no sonarán cuando tu dispositivo esté en modo silencio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active « Respecter le mode silencieux » dans les Réglages, et les jeux restent muets quand ton appareil est en mode silencieux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva «Rispetta la modalità silenziosa» in Impostazioni e i giochi restano muti quando il dispositivo è in modalità silenziosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」で「消音モードに従う」をオンにすると、デバイスが消音モードのときゲームの音が鳴りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 '무음 모드 따르기'를 켜면 기기가 무음 모드일 때 게임 소리가 나지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative “Respeitar o modo silencioso” em Ajustes, e os jogos ficam mudos quando o dispositivo está no modo silencioso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Учитывать бесшумный режим» в настройках, и игры будут молчать, когда устройство в бесшумном режиме."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”中打开“遵循静音模式”，设备处于静音模式时游戏就不会出声。"
          }
        }
      }
    }
  },
  "version" : "1.1"
}
