    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "System prompt that asks for Bluetooth access.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo nutzt Bluetooth, damit du mit einem kabellosen Controller spielen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Empo uses Bluetooth so you can play with a wireless game controller."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo usa Bluetooth para que puedas jugar con un mando inalámbrico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo utilise le Bluetooth pour que tu puisses jouer avec une manette sans fil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo usa il Bluetooth per farti giocare con un controller wireless."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワイヤレスのゲームコントローラで遊べるように、EmpoはBluetoothを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무선 게임 컨트롤러로 플레이할 수 있도록 Empo가 Bluetooth를 사용해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Empo usa o Bluetooth para você jogar com um controle sem fio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo использует Bluetooth, чтобы вы могли играть с беспроводным геймпадом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo 使用蓝牙，让你可以用无线游戏手柄来玩。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "System prompt that asks for camera access.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach ein Foto, um es als eigenes Spielbild oder Banner zu nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Take a photo to use as custom game artwork or banner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una foto para usarla como portada o banner del juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prends une photo pour l’utiliser comme illustration ou bannière de jeu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scatta una foto da usare come copertina o banner del gioco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を撮って、ゲームのアートワークやバナーに使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진을 찍어 게임 아트워크나 배너로 사용할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tire uma foto para usar como capa ou banner do jogo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте фото, чтобы использовать его как обложку или баннер игры."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍一张照片，用作自定义游戏封面或横幅。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "System prompt that asks for local network access.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo nutzt dein Netzwerk, um Spieler in der Nähe zu finden und Backups auf deinem eigenen Server zu speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Empo uses your network to find nearby players and to back up to your own server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo usa tu red para buscar jugadores cercanos y guardar copias de seguridad en tu propio servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo utilise ton réseau pour trouver des joueurs à proximité et sauvegarder sur ton propre serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo usa la tua rete per trovare giocatori vicini e fare il backup sul tuo server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empoはネットワークを使って、近くのプレイヤーを探したり、自分のサーバーにバックアップしたりします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo가 네트워크를 사용해 근처 플레이어를 찾고 내 서버에 백업해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Empo usa sua rede para encontrar jogadores por perto e fazer backup no seu próprio servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo использует вашу сеть, чтобы находить игроков поблизости и сохранять резервные копии на вашем сервере."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo 会使用你的网络查找附近的玩家，并备份到你自己的服务器。"
          }
        }
      }
    }
