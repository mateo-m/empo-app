        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo 使用蓝牙，让你可以用无线游戏手柄来玩。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "System prompt that asks for camera access.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach ein Foto, um es als eigenes Spielbild oder Banner zu nutzen."
