    "NSLocalNetworkUsageDescription" : {
      "comment" : "System prompt that asks for local network access.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo findet Spieler in deinem Netzwerk, damit du lokale Mehrspielerspiele spielen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Empo finds nearby players on your network so you can play local multiplayer games."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo busca jugadores cercanos en tu red para que puedas jugar partidas multijugador locales."
