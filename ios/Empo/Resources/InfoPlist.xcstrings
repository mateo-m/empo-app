    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "System prompt that asks for Bluetooth access.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo nutzt Bluetooth, damit du mit einem kabellosen Controller spielen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Empo uses Bluetooth so you can play with a wireless game controller."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo usa Bluetooth para que puedas jugar con un mando inalámbrico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo utilise le Bluetooth pour que tu puisses jouer avec une manette sans fil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo usa il Bluetooth per farti giocare con un controller wireless."
