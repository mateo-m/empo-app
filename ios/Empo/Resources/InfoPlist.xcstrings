        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo trouve les joueurs à proximité sur ton réseau pour que tu puisses jouer en multijoueur local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo trova i giocatori vicini sulla tua rete, così puoi giocare in multiplayer locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルマルチプレイで遊べるように、Empoはネットワーク上の近くのプレイヤーを探します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 멀티플레이를 할 수 있도록 Empo가 네트워크에서 근처 플레이어를 찾아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Empo encontra jogadores por perto na sua rede para você jogar multiplayer local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo ищет игроков поблизости в вашей сети, чтобы вы могли играть в локальный мультиплеер."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
