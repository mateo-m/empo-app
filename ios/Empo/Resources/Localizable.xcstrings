    "%@ deletes older logs each time you start a game." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ löscht ältere Logs bei jedem Spielstart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ elimina los registros más antiguos cada vez que abres un juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ supprime les anciens journaux à chaque lancement de jeu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ elimina i log più vecchi ogni volta che avvii un gioco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は、ゲームを起動するたびに古いログを削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@는 게임을 시작할 때마다 오래된 로그를 지워요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
