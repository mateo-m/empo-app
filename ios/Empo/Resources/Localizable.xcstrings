    "Scale all in-game text. 1.0x is the default size." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skaliert allen Text im Spiel. 1,0x ist die normale Größe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia el tamaño de todo el texto del juego. 1.0x es el tamaño normal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrandit ou réduit tout le texte du jeu. 1,0x est la taille par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scala tutto il testo del gioco. 1,0x è la dimensione normale."
