    "Auto-detect reads the game's scripts and picks the correct Ruby version. Change it only if the game shows a script error or runs wrongly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatisch“ liest die Skripte des Spiels und wählt die passende Ruby-Version. Ändere das nur, wenn das Spiel einen Skriptfehler zeigt oder nicht richtig läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático lee los scripts del juego y elige la versión de Ruby correcta. Cámbiala solo si el juego muestra un error de script o no funciona bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La détection auto lit les scripts du jeu et choisit la bonne version de Ruby. Change-la seulement si le jeu affiche une erreur de script ou fonctionne mal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatico legge gli script del gioco e sceglie la versione di Ruby giusta. Cambiala solo se il gioco mostra un errore di script o non funziona bene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動検出では、ゲームのスクリプトを読んで正しいRubyのバージョンを選びます。スクリプトエラーが出るときや、ゲームが正しく動かないときだけ変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 감지는 게임 스크립트를 읽고 알맞은 Ruby 버전을 골라요. 게임에 스크립트 오류가 나거나 제대로 돌아가지 않을 때만 바꾸세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo Automático lê os scripts do jogo e escolhe a versão certa do Ruby. Mude só se o jogo mostrar um erro de script ou não rodar direito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоопределение читает скрипты игры и выбирает нужную версию Ruby. Меняйте это, только если игра выдаёт ошибку скрипта или работает неправильно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动检测会读取游戏脚本，选出合适的 Ruby 版本。只有在游戏出现脚本错误或运行异常时才需要更改。"
          }
        }
      }
    },
