    "It stopped responding and will close. Progress you haven't saved will be lost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es reagiert nicht mehr und wird beendet. Nicht gespeicherter Fortschritt geht verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejó de responder y se va a cerrar. Perderás el progreso que no hayas guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne répond plus et va se fermer. Ta progression non sauvegardée sera perdue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non risponde più e verrà chiuso. I progressi non salvati andranno persi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "応答しなくなったため、終了します。セーブしていない進行状況は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응답하지 않아서 닫혀요. 저장하지 않은 진행 상황은 사라져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele parou de responder e vai fechar. Você vai perder o progresso que não salvou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игра перестала отвечать и закроется. Несохранённый прогресс пропадёт."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏没有响应，即将关闭。没保存的进度会丢失。"
          }
        }
      }
    },
