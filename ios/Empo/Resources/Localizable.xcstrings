    "This archive looks unsafe, so Empo stopped the import. Get the game from a source you trust." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Archiv wirkt unsicher, deshalb hat Empo den Import gestoppt. Lade das Spiel aus einer Quelle, der du vertraust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo comprimido no parece seguro, así que Empo detuvo la importación. Descarga el juego de un sitio de confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette archive semble dangereuse, donc Empo a arrêté l'import. Récupère le jeu depuis une source de confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo archivio non sembra sicuro, quindi Empo ha interrotto l'importazione. Scarica il gioco da una fonte di cui ti fidi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアーカイブは安全ではなさそうなので、インポートを中止しました。信頼できる入手先からゲームを手に入れてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 압축 파일이 안전하지 않아 보여서 가져오기를 중지했어요. 믿을 수 있는 곳에서 게임을 받아 주세요."
          }
        },
