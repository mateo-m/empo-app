      }
    },
    "You stopped the restore. The files it already restored stay." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast die Wiederherstellung gestoppt. Bereits wiederhergestellte Dateien bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detuviste la restauración. Los archivos ya restaurados se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as arrêté la restauration. Les fichiers déjà restaurés restent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai interrotto il ripristino. I file già ripristinati restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元を中止しました。すでに復元したファイルはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복원을 중지했어요. 이미 복원된 파일은 그대로 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você parou a restauração. Os arquivos já restaurados continuam lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы остановили восстановление. Уже восстановленные файлы останутся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你停止了恢复。已经恢复的文件会保留。"
          }
        }
      }
    },
    "You stopped the restore. What it already restored stays." : {
