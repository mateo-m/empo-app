    },
    "This key can't write to the bucket. Give it the rights to read, write, and delete files." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Schlüssel kann nicht in den Bucket schreiben. Gib ihm die Rechte zum Lesen, Schreiben und Löschen von Dateien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta clave no puede escribir en el bucket. Dale permiso para leer, escribir y eliminar archivos."
