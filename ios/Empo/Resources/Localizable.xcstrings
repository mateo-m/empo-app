    "The restore stopped because a game started. Try again when you stop playing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiederherstellung wurde gestoppt, weil ein Spiel gestartet wurde. Versuch es noch mal, wenn du fertig gespielt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
