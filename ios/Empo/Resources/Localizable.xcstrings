          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстанавливает игру в нынешнем виде на любом устройстве."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可在任何设备上把游戏恢复成现在的样子。"
          }
        }
