        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta compilación de Empo no incluye “%@”, así que no puede ejecutar este juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque un cœur à cette version d'Empo : %@. Elle ne peut donc pas lancer ce jeu."
