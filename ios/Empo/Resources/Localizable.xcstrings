          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除你做的所有更改，改用游戏原本的设置。"
          }
        }
      }
    },
    "Clears the buttons you changed for all games. Buttons you changed for one game stay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt die Tasten zurück, die du für alle Spiele geändert hast. Tasten, die du für ein einzelnes Spiel geändert hast, bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restablece los botones que cambiaste para todos los juegos. Los que cambiaste para un solo juego se mantienen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface les boutons que tu as modifiés pour tous les jeux. Les boutons modifiés pour un seul jeu restent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riporta ai valori predefiniti i pulsanti che hai modificato per tutti i giochi. Quelli modificati per un solo gioco restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのゲーム向けに変えたボタンを元に戻します。ゲームごとに変えたボタンはそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 게임에 바꾼 버튼을 초기화해요. 게임 하나에만 바꾼 버튼은 그대로예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desfaz as mudanças de botões feitas para todos os jogos. As mudanças feitas para um único jogo continuam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбрасывает кнопки, которые вы меняли для всех игр. Кнопки, изменённые для одной игры, останутся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除你为所有游戏改过的按键。单独为某个游戏改过的按键会保留。"
          }
        }
      }
    },
