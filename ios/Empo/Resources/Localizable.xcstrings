    "Delete %@? %lld games use it and will switch to Automatic. You can't undo this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@sentence@"
          },
          "substitutions" : {
            "sentence" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$@ löschen? %arg Spiel nutzt es und wechselt zu „Automatisch“. Du kannst das nicht rückgängig machen."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
