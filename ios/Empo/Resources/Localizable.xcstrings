    "You have Empo %@.\nAdd Dropbox, Google Drive, or your own server in Backups." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast Empo %@.\nFüg Dropbox, Google Drive oder deinen eigenen Server unter „Backups“ hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes Empo %@.\nAñade Dropbox, Google Drive o tu propio servidor en Copias de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as Empo %@.\nAjoute Dropbox, Google Drive ou ton propre serveur dans Copies de secours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai Empo %@.\nAggiungi Dropbox, Google Drive o un tuo server in Backup."
