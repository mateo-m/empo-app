    "Use the game's own keyboard for names instead of the iOS one. Turn it on for Pokemon Essentials games with custom keys." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzt für Namen die Tastatur des Spiels statt der von iOS. Schalte das für Pokemon-Essentials-Spiele mit eigenen Tasten ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el teclado del propio juego para los nombres en vez del de iOS. Actívalo en juegos de Pokemon Essentials con teclas personalizadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise le clavier du jeu pour les noms au lieu de celui d'iOS. Active-le pour les jeux Pokemon Essentials avec des touches personnalisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la tastiera del gioco per i nomi invece di quella di iOS. Attivala per i giochi Pokemon Essentials con tasti personalizzati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSのキーボードの代わりに、名前入力でゲーム独自のキーボードを使います。独自のキーを使うPokemon Essentialsのゲームではオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름을 입력할 때 iOS 키보드 대신 게임 자체 키보드를 써요. 키를 따로 정한 Pokemon Essentials 게임에서 켜 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o teclado do próprio jogo para nomes em vez do teclado do iOS. Ligue para jogos de Pokemon Essentials com teclas personalizadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вводить имена с клавиатуры самой игры, а не iOS. Включите для игр на Pokemon Essentials с нестандартными клавишами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入名字时使用游戏自己的键盘，而不是 iOS 键盘。适合有自定义按键的 Pokemon Essentials 游戏。"
          }
        }
      }
    },
    "Use these if a game misbehaves or you want to report a bug." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze das, wenn ein Spiel spinnt oder du einen Bug melden willst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úsalos si un juego falla o quieres reportar un error."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise-les si un jeu se comporte mal ou si tu veux signaler un bug."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usale se un gioco dà problemi o se vuoi segnalare un bug."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームの動きがおかしいときや、バグを報告したいときに使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임이 이상하게 동작하거나 버그를 알리고 싶을 때 써 보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use estas opções se um jogo der problema ou se você quiser relatar um bug."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пригодятся, если игра работает странно или вы хотите сообщить о баге."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏出问题或你想反馈 bug 时，可以用这些设置。"
          }
        }
