    "Find game files faster. Turn it off if the game can't find its images or sounds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findet Spieldateien schneller. Schalte es aus, wenn das Spiel seine Bilder oder Sounds nicht findet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra antes los archivos del juego. Desactívalo si el juego no encuentra sus imágenes o sonidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouve les fichiers du jeu plus vite. Désactive-le si le jeu ne trouve pas ses images ou ses sons."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova più in fretta i file del gioco. Disattivalo se il gioco non trova le sue immagini o i suoi suoni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームのファイルを速く見つけます。ゲームの画像や音が見つからないときはオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임 파일을 더 빨리 찾아요. 게임이 이미지나 소리를 못 찾으면 꺼 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontra os arquivos do jogo mais rápido. Desligue se o jogo não achar as imagens ou os sons dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрее находить файлы игры. Выключите, если игра не находит свои картинки или звуки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更快地找到游戏文件。如果游戏找不到图片或声音，请关闭它。"
          }
        }
      }
    },
