        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경 사항을 적용하려면 앱 전환기에서 %@를 닫고 다시 열어 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
