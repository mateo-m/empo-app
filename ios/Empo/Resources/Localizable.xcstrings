    "Add Fast Forward to the Game menu while you play. When it's on, the game runs at the speed below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt beim Spielen „Schnellvorlauf“ zum Menü „Spiel“ hinzu. Ist er an, läuft das Spiel mit der Geschwindigkeit unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade Avance rápido al menú Juego mientras juegas. Cuando está activado, el juego va a la velocidad de abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute Avance rapide au menu Jeu pendant que tu joues. Quand elle est activée, le jeu tourne à la vitesse ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge Avanti veloce al menu Gioco mentre giochi. Quando è attivo, il gioco va alla velocità qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遊んでいる間、「ゲーム」メニューに「早送り」を追加します。オンのときは、下の速度でゲームが動きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플레이 중에 게임 메뉴에 빨리 감기를 추가해요. 켜면 게임이 아래 속도로 돌아가요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona Avanço Rápido ao menu Jogo enquanto você joga. Quando está ligado, o jogo roda na velocidade abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет «Ускорение» в меню «Игра» во время игры. Когда оно включено, игра идёт со скоростью, указанной ниже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游玩时在“游戏”菜单中加入“快进”。打开后，游戏会以下面的速度运行。"
          }
        }
      }
    },
