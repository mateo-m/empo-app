    "The whole game" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ganze Spiel"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego completo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu entier"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'intero gioco"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲーム全体"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임 전체"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O jogo inteiro"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вся игра"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
