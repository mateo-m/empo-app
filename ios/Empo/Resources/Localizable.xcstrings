    },
    "A restore moved %@ aside and wrote the backup's files in their place. The moved files hold %@. You can't undo this." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Wiederherstellung hat %@ beiseitegelegt und an ihrer Stelle die Dateien aus dem Backup geschrieben. Die verschobenen Dateien belegen %@. Du kannst das nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una restauración apartó %@ y escribió en su lugar los archivos de la copia de seguridad. Los archivos apartados ocupan %@. No puedes deshacer esto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une restauration a mis %@ de côté et a écrit les fichiers de la copie de secours à leur place. Les fichiers déplacés occupent %@. Tu ne peux pas annuler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ripristino ha spostato da parte %@ e ha scritto al loro posto i file del backup. I file spostati occupano %@. Non puoi annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元のときに%@が別の場所に移され、代わりにバックアップのファイルが書き込まれました。移されたファイルのサイズは%@です。元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복원할 때 %@를 따로 옮기고 그 자리에 백업 파일을 썼어요. 옮긴 파일의 크기는 모두 %@ 분량이에요. 되돌릴 수 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma restauração separou %@ e gravou os arquivos do backup no lugar deles. Os arquivos separados ocupam %@. Você não pode desfazer isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановление отложило в сторону %@ и записало на их место файлы из резервной копии. Отложенные файлы занимают %@. Это действие нельзя отменить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复时把%@移到了一旁，并在原位置写入了备份中的文件。移走的文件共 %@。此操作无法撤销。"
          }
        }
      }
    },
    "A restore moved these files aside. They hold %@ of the game files %@ had before that restore. You can't undo this." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Wiederherstellung hat diese Dateien beiseitegelegt. Sie enthalten %@ der Spieldateien, die %@ vor dieser Wiederherstellung hatte. Du kannst das nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una restauración apartó estos archivos. Contienen %@ de los archivos que tenía %@ antes de esa restauración. No puedes deshacer esto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une restauration a mis ces fichiers de côté. Ils contiennent %@ des fichiers de jeu que %@ avait avant cette restauration. Tu ne peux pas annuler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ripristino ha spostato da parte questi file. Contengono %@ dei file di gioco che %@ aveva prima di quel ripristino. Non puoi annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元のときに、これらのファイルは別の場所に移されました。復元前の%2$@のゲームファイルで、サイズは%1$@です。元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복원할 때 이 파일들을 따로 옮겨 뒀어요. 복원 전 %2$@의 게임 파일로, 크기는 %1$@예요. 되돌릴 수 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma restauração separou estes arquivos. Eles têm %@ dos arquivos de jogo que %@ tinha antes dessa restauração. Você não pode desfazer isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При восстановлении эти файлы были отложены. В них %@ файлов игры «%@» до восстановления. Это действие нельзя отменить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复时这些文件被移到了一旁。它们是%2$@在那次恢复前的游戏文件，共 %1$@。此操作无法撤销。"
          }
        }
      }
    },
    "A save file didn't copy (%@)." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Spielstand wurde nicht kopiert (%@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una partida guardada no se copió (%@)."
          }
        },
        "fr" : {
