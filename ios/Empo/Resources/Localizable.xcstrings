    "Clears every change you made and uses the game's original values." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt alle deine Änderungen zurück und nutzt die Originalwerte des Spiels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra todos tus cambios y vuelve a los valores originales del juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface toutes tes modifications et reprend les valeurs d'origine du jeu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella tutte le tue modifiche e usa i valori originali del gioco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分で変えた設定をすべて消して、ゲーム本来の値に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
