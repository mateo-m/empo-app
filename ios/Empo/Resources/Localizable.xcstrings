        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Empo só avisa quando você precisa resolver algo, como entrar de novo ou liberar espaço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo присылает уведомления, только когда нужно что-то исправить: например, снова войти или освободить место."
