    "Pauses the game and takes you back to your library." : {
      "comment" : "Name or description of a controller action, in the list of what a button can do.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert das Spiel und bringt dich zurück zu deiner Bibliothek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa el juego y te lleva de vuelta a tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met le jeu en pause et te ramène à ta bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette in pausa il gioco e ti riporta alla libreria."
