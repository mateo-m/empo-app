    "It also changes the settings on every device that syncs with this one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ändert auch die Einstellungen auf jedem Gerät, das mit diesem synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También cambia los ajustes en todos los dispositivos que se sincronizan con este."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela modifie aussi les réglages sur chaque appareil synchronisé avec celui-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia anche le impostazioni su ogni dispositivo sincronizzato con questo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末と同期しているすべての端末の設定も変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기와 동기화하는 모든 기기의 설정도 바뀌어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso também muda os ajustes em todos os dispositivos sincronizados com este."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки также изменятся на всех устройствах, которые синхронизируются с этим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这也会更改所有与这台设备同步的设备上的设置。"
          }
        }
      }
    },
