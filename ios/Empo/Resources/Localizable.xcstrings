    "Close %@ from the app switcher and open it again to apply this change." : {
      "comment" : "The placeholder is the app name, Empo.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließ %@ im App-Umschalter und öffne es wieder, damit die Änderung gilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra %@ desde el selector de apps y vuelve a abrirlo para aplicar este cambio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferme %@ depuis le sélecteur d'apps, puis rouvre-le pour appliquer ce changement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudi %@ dall'App Switcher, poi riaprilo per applicare la modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更を反映するには、Appスイッチャーで%@を閉じてから、もう一度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경 사항을 적용하려면 앱 전환기에서 %@를 닫고 다시 열어 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feche o %@ no seletor de apps e abra de novo para aplicar a mudança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закройте %@ в переключателе приложений и откройте снова, чтобы применить изменение."
