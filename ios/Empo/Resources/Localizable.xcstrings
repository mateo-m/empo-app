    "Save often. If you hit issues, report them on [**GitHub**](%@)." : {
      "comment" : "Launch disclaimer. Keep the Markdown link. The placeholder is the URL of the issues page.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere oft. Wenn etwas schiefgeht, melde es auf [**GitHub**](%@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda a menudo. Si encuentras problemas, repórtalos en [**GitHub**](%@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegarde souvent. Si tu rencontres des problèmes, signale-les sur [**GitHub**](%@)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva spesso. Se trovi problemi, segnalali su [**GitHub**](%@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こまめにセーブしてくださいね。問題があったら[**GitHub**](%@)で教えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자주 저장하세요. 문제가 생기면 [**GitHub**](%@)에 알려 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve com frequência. Se der problema, avise no [**GitHub**](%@)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняйтесь почаще. Если что-то сломается, напишите об этом на [**GitHub**](%@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记得常存档。遇到问题的话，欢迎到 [**GitHub**](%@) 反馈。"
          }
        }
      }
    },
    "Saves a log for each play session. Find them in Files, under %@ › Games › the game's name › Logs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichert ein Log für jede Spielsitzung. Du findest sie in Dateien unter %@ › Games › Name des Spiels › Logs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda un registro de cada sesión de juego. Los encontrarás en Archivos, en %@ › Games › el nombre del juego › Logs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre un journal pour chaque session de jeu. Tu les trouveras dans Fichiers, sous %@ › Games › le nom du jeu › Logs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva un log per ogni sessione di gioco. Li trovi in File, in %@ › Games › nome del gioco › Logs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレイごとにログを保存します。「ファイル」の%@ › Games › ゲーム名 › Logsにあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플레이할 때마다 로그를 저장해요. 파일 앱의 %@ › Games › 게임 이름 › Logs에서 찾을 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva um log de cada sessão de jogo. Eles ficam em Arquivos, em %@ › Games › nome do jogo › Logs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняет лог каждой игровой сессии. Логи лежат в «Файлах»: %@ › Games › название игры › Logs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每次游玩保存一份日志。可在“文件”中的 %@ › Games › 游戏名称 › Logs 里找到。"
          }
        }
      }
    },
