    "Smooth the picture when the game scales up. Turn it off to keep the pixels crisp." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glättet das Bild, wenn das Spiel hochskaliert wird. Schalte es aus, damit die Pixel scharf bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suaviza la imagen cuando el juego se amplía. Desactívalo para que los píxeles se vean nítidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisse l'image quand le jeu est agrandi. Désactive-le pour garder des pixels nets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ammorbidisce l'immagine quando il gioco viene ingrandito. Disattivalo per tenere i pixel nitidi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームを拡大するときに画像をなめらかにします。ドットをくっきり見せたいときはオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임을 확대할 때 화면을 부드럽게 처리해요. 끄면 픽셀이 또렷하게 유지돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suaviza a imagem quando o jogo é ampliado. Desligue para manter os pixels nítidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сглаживать картинку при увеличении. Выключите, чтобы пиксели оставались чёткими."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏放大时让画面更平滑。关闭可保持像素清晰锐利。"
          }
        }
      }
    },
