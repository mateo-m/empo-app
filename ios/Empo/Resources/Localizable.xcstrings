    "This device is full. Free up space, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät ist voll. Schaff Platz und versuch es noch mal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo está lleno. Libera espacio e inténtalo de nuevo."
          }
