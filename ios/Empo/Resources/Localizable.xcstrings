    "Things can crash, freeze, or refuse to load." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manches stürzt ab, hängt oder lädt nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que algo se cierre, se congele o no cargue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça peut planter, se figer ou refuser de charger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Può capitare che qualcosa si chiuda, si blocchi o non si carichi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュしたり、固まったり、読み込めなかったりすることがあります。"
