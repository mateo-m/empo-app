    "Deletes games that failed to import the next time you open %@. You can't undo this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht Spiele, deren Import fehlgeschlagen ist, beim nächsten Öffnen von %@. Du kannst das nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La próxima vez que abras %@, elimina los juegos que no se importaron bien. No puedes deshacer esto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les jeux dont l'import a échoué la prochaine fois que tu ouvres %@. Tu ne peux pas annuler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina i giochi non importati correttamente alla prossima apertura di %@. Non puoi annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次に%@を開いたとき、インポートに失敗したゲームを削除します。元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음에 %@를 열 때 가져오기에 실패한 게임을 삭제해요. 되돌릴 수 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
