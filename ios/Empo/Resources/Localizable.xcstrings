        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임 속 모든 글자의 크기를 조절해요. 1.0x가 기본 크기예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muda o tamanho de todo o texto do jogo. 1,0x é o tamanho padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Масштаб всего текста в игре. 1.0x — обычный размер."
