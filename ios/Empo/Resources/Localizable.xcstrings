    "Fast forward is off for this game. The button shows in games that have Fast forward on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnellvorlauf ist für dieses Spiel aus. Der Button erscheint in Spielen, bei denen Schnellvorlauf an ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El avance rápido está desactivado en este juego. El botón aparece en los juegos que lo tienen activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'avance rapide est désactivée pour ce jeu. Le bouton s'affiche dans les jeux où l'avance rapide est activée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanti veloce è disattivato per questo gioco. Il pulsante appare nei giochi con Avanti veloce attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このゲームでは早送りがオフです。このボタンは、早送りがオンのゲームで表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 게임은 빨리 감기가 꺼져 있어요. 이 버튼은 빨리 감기를 켠 게임에서 보여요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Avanço rápido está desligado neste jogo. O botão aparece nos jogos com Avanço rápido ligado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ускорение в этой игре выключено. Кнопка появится в играх, где ускорение включено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个游戏的快进已关闭。这个按钮只会在开启了快进的游戏中显示。"
          }
        }
      }
    },
