    "Quit a game and start another one without closing %@. Works with %@." : {
      "comment" : "The first placeholder is the app name, Empo. The second is a list of game types, for example RPG Maker XP games and PSDK games.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende ein Spiel und starte ein anderes, ohne %@ zu schließen. Geht mit %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sal de un juego y empieza otro sin cerrar %@. Funciona con %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitte un jeu et lances-en un autre sans fermer %@. Fonctionne avec %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esci da un gioco e avviane un altro senza chiudere %@. Funziona con %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を閉じずに、ゲームを終了して別のゲームを始められます。対応：%@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@를 닫지 않고 게임을 종료하고 다른 게임을 시작해요. %@에서 작동해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saia de um jogo e comece outro sem fechar o %@. Funciona com %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выходите из игры и запускайте другую, не закрывая %@. Работает для: %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需关闭 %@ 即可退出游戏并开始另一个。适用于%@。"
          }
        }
      }
    },
