    "Send taps and drags on the game screen to the game as mouse input." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leitet Tippen und Ziehen auf dem Spielbildschirm als Mauseingabe an das Spiel weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía al juego tus toques y arrastres en la pantalla como si fueran el ratón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie au jeu tes touchers et glissements sur l'écran de jeu, comme une souris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia al gioco tocchi e trascinamenti sullo schermo come input del mouse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲーム画面でのタップやドラッグを、マウス操作としてゲームに送ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임 화면의 탭과 드래그를 마우스 입력으로 게임에 보내요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
