    "Keep separate starts with a full upload. Both devices keep their history." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Getrennt halten“ beginnt mit einem vollständigen Upload. Beide Geräte behalten ihren Verlauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Mantener separadas” empieza con una subida completa. Ambos dispositivos conservan su historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Garder séparé » commence par un envoi complet. Les deux appareils gardent leur historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Tieni separati» inizia con un caricamento completo. Entrambi i dispositivi mantengono la loro cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「別々にする」を選ぶと、最初にすべてをアップロードします。両方の端末で履歴が残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“따로 유지”를 고르면 처음에 전체를 업로드해요. 두 기기 모두 기록이 유지돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Manter separado” começa com um envio completo. Os dois dispositivos mantêm o histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Хранить отдельно» начинается с полной загрузки. У обоих устройств сохранится история."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“分开保存”会先完整上传一次。两台设备都会保留各自的历史记录。"
          }
        }
      }
    },
