    "Empo makes its own Empo folder in here. Leave it empty to make it at the address itself." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo legt hier einen eigenen Empo-Ordner an. Lass das Feld leer, um ihn direkt unter der Adresse anzulegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empo crea aquí su propia carpeta Empo. Déjalo vacío para crearla directamente en la dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
