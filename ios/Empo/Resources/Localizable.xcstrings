    "To play again, close Empo from the app switcher, then open it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um wieder zu spielen, schließ Empo im App-Umschalter und öffne es neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para volver a jugar, cierra Empo desde el selector de apps y ábrelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour rejouer, ferme Empo depuis le sélecteur d'apps, puis rouvre-le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per giocare di nuovo, chiudi Empo dall'App Switcher, poi riaprilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一度遊ぶには、AppスイッチャーでEmpoを閉じてから、もう一度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 플레이하려면 앱 전환기에서 Empo를 닫고 다시 열어 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para jogar de novo, feche o Empo no seletor de apps e abra outra vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы снова играть, закройте Empo в переключателе приложений и откройте заново."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
