    "Show a Fast forward switch in the More menu while you play. When the switch is on, the game runs at the speed below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt beim Spielen einen Schalter für den Schnellvorlauf im Menü „Mehr“. Ist der Schalter an, läuft das Spiel mit der Geschwindigkeit unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra un interruptor de avance rápido en el menú Más mientras juegas. Cuando está activado, el juego va a la velocidad de abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche un interrupteur Avance rapide dans le menu Plus pendant que tu joues. Quand il est activé, le jeu tourne à la vitesse ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra un interruttore Avanti veloce nel menu Altro mentre giochi. Quando è attivo, il gioco va alla velocità qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遊んでいる間、「その他」メニューに早送りのスイッチを表示します。スイッチがオンのときは、下の速度でゲームが動きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플레이 중에 “더 보기” 메뉴에 빨리 감기 스위치를 보여 줘요. 스위치를 켜면 게임이 아래 속도로 돌아가요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra uma opção de Avanço rápido no menu Mais enquanto você joga. Com a opção ligada, o jogo roda na velocidade abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
