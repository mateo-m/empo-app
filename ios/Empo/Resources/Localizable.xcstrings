          }
        }
      }
    },
    "%@ also backs up to %@. Where should new backups from this device go?" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sichert auch in %@. Wohin sollen neue Backups von diesem Gerät gehen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ también hace copias de seguridad en %@. ¿Adónde deben ir las nuevas copias de este dispositivo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fait aussi ses copies de secours sur %@. Où doivent aller les nouvelles copies de secours de cet appareil ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche %@ fa il backup su %@. Dove devono andare i nuovi backup di questo dispositivo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@も%@にバックアップしています。この端末の新しいバックアップをどこに保存しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@도 %@에 백업하고 있어요. 이 기기의 새 백업을 어디에 둘까요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ também faz backup em %@. Para onde devem ir os novos backups deste dispositivo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ тоже отправляет резервные копии в %@. Куда сохранять новые резервные копии с этого устройства?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 也在备份到 %@。这台设备的新备份要放到哪里？"
          }
        }
      }
    },
