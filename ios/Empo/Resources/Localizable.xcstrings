    "Profiles live in Settings and work for any game." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile findest du in den Einstellungen. Sie funktionieren mit jedem Spiel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles están en Ajustes y sirven para cualquier juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils se trouvent dans Réglages et marchent pour tous les jeux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I profili sono nelle Impostazioni e funzionano con qualsiasi gioco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルは「設定」にあり、どのゲームでも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필은 설정에 있고, 어떤 게임에서든 쓸 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os perfis ficam em Ajustes e servem para qualquer jogo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профили хранятся в настройках и подходят для любой игры."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "方案保存在“设置”中，适用于任何游戏。"
          }
        }
      }
    },
    "Profiles live in Settings and work for any game. The profile also sets where the game sits on screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile findest du in den Einstellungen. Sie funktionieren mit jedem Spiel. Das Profil legt auch fest, wo das Spiel auf dem Bildschirm sitzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles están en Ajustes y sirven para cualquier juego. El perfil también decide dónde se coloca el juego en la pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils se trouvent dans Réglages et marchent pour tous les jeux. Le profil définit aussi la position du jeu à l'écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I profili sono nelle Impostazioni e funzionano con qualsiasi gioco. Il profilo decide anche dove sta il gioco sullo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルは「設定」にあり、どのゲームでも使えます。ゲーム画面の位置もプロファイルで決まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필은 설정에 있고, 어떤 게임에서든 쓸 수 있어요. 게임이 화면 어디에 놓일지도 프로필이 정해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os perfis ficam em Ajustes e servem para qualquer jogo. O perfil também define onde o jogo fica na tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профили хранятся в настройках и подходят для любой игры. Профиль также задаёт положение игры на экране."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "方案保存在“设置”中，适用于任何游戏。方案还决定游戏画面在屏幕上的位置。"
          }
        }
      }
    },
    "Progress you haven't saved will be lost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht gespeicherter Fortschritt geht verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perderás el progreso que no hayas guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta progression non sauvegardée sera perdue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I progressi non salvati andranno persi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セーブしていない進行状況は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하지 않은 진행 상황은 사라져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você vai perder o progresso que não salvou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Несохранённый прогресс пропадёт."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没保存的进度会丢失。"
          }
        }
      }
    },
    "Puts back your saves, settings, and control layouts. Touches nothing else." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt deine Spielstände, Einstellungen und Steuerungslayouts wieder her. Sonst ändert sich nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura tus partidas guardadas, ajustes y diseños de controles. No toca nada más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remet tes sauvegardes, tes réglages et tes dispositions de commandes. Ne touche à rien d'autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina salvataggi, impostazioni e layout dei controlli. Non tocca nient'altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セーブデータ、設定、操作レイアウトを元に戻します。それ以外は変更しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세이브, 설정, 컨트롤 레이아웃을 되돌려요. 다른 건 건드리지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devolve seus saves, ajustes e layouts de controles. Não mexe em mais nada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возвращает ваши сохранения, настройки и раскладки управления. Больше ничего не меняет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复你的存档、设置和按键布局，其他内容不变。"
          }
        }
      }
    },
    "Puts the game back as it is now, on any device." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt das Spiel so wieder her, wie es jetzt ist, auf jedem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura el juego tal como está ahora, en cualquier dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remet le jeu tel qu'il est maintenant, sur n'importe quel appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina il gioco com'è ora, su qualsiasi dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの端末でも、ゲームを今の状態に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어느 기기에서나 게임을 지금 상태로 되돌려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
