    "This account can't write to that folder. Check its rights on the server." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Account kann nicht in diesen Ordner schreiben. Prüf seine Rechte auf dem Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cuenta no puede escribir en esa carpeta. Revisa sus permisos en el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte ne peut pas écrire dans ce dossier. Vérifie ses droits sur le serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo account non può scrivere in quella cartella. Controlla i suoi permessi sul server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントではそのフォルダに書き込めません。サーバでアカウントの権限を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 계정으로는 그 폴더에 쓸 수 없어요. 서버에서 계정 권한을 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conta não consegue gravar nessa pasta. Confira as permissões dela no servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта учётная запись не может записывать в эту папку. Проверьте её права на сервере."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个账户无法写入该文件夹。请在服务器上检查它的权限。"
          }
        }
      }
    },
    "This backup holds different game files than %@ has on this device. Mixing two sets of game files can break the game.\n\nWhat should happen to the game files already here?" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Backup enthält andere Spieldateien als „%@“ auf diesem Gerät. Wenn du zwei Sätze Spieldateien mischst, kann das Spiel kaputtgehen.\n\nWas soll mit den Spieldateien passieren, die schon hier sind?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia tiene archivos de juego distintos de los que “%@” tiene en este dispositivo. Mezclar dos grupos de archivos de juego puede estropear el juego.\n\n¿Qué hacemos con los archivos de juego que ya están aquí?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette copie de secours contient d'autres fichiers de jeu que ceux de « %@ » sur cet appareil. Mélanger deux ensembles de fichiers de jeu peut casser le jeu.\n\nQue faire des fichiers de jeu déjà présents ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo backup contiene file di gioco diversi da quelli di «%@» su questo dispositivo. Mischiare due gruppi di file di gioco può rovinare il gioco.\n\nCosa vuoi fare con i file di gioco già presenti?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバックアップには、この端末の「%@」とは異なるゲームファイルが入っています。2組のゲームファイルを混ぜると、ゲームが動かなくなることがあります。\n\nこの端末にあるゲームファイルをどうしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 백업에는 이 기기의 “%@” 게임과 다른 게임 파일이 들어 있어요. 두 가지 게임 파일을 섞으면 게임이 망가질 수 있어요.\n\n여기 있는 게임 파일은 어떻게 할까요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este backup tem arquivos de jogo diferentes dos que “%@” tem neste dispositivo. Misturar dois conjuntos de arquivos de jogo pode estragar o jogo.\n\nO que fazer com os arquivos de jogo que já estão aqui?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этой копии другие файлы игры, чем у «%@» на этом устройстве. Если смешать два набора файлов игры, игра может сломаться.\n\nЧто сделать с файлами игры, которые уже здесь?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个备份里的游戏文件与这台设备上“%@”的不同。混用两套游戏文件可能会让游戏无法运行。\n\n这里现有的游戏文件要怎么处理？"
          }
        }
      }
    },
    "This backup needs a newer version of Empo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für dieses Backup brauchst du eine neuere Version von Empo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
