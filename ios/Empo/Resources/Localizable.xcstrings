          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desfaz todas as mudanças que você fez e usa os valores originais do jogo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
