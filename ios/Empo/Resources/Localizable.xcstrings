    "Backs up over cellular as well as Wi-Fi. Low Data Mode always pauses backups." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichert über mobile Daten und WLAN. Im Modus für wenig Daten pausieren Backups immer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace copias de seguridad con datos móviles y con Wi-Fi. El modo de datos reducidos siempre las pausa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait les copies de secours via le réseau cellulaire et le Wi-Fi. Le mode Données réduites les met toujours en pause."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegue il backup con la rete cellulare e con il Wi-Fi. La modalità Dati ridotti mette sempre in pausa i backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fiだけでなくモバイルデータ通信でもバックアップします。省データモードでは常にバックアップを一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi뿐 아니라 셀룰러 데이터로도 백업해요. 저데이터 모드에서는 항상 백업을 일시 정지해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz backup pelos dados celulares e pelo Wi-Fi. O Modo Dados Reduzidos sempre pausa os backups."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создаёт резервные копии по сотовой сети и по Wi-Fi. В режиме низкого трафика копирование всегда на паузе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过蜂窝数据和 Wi-Fi 备份。低数据模式下始终暂停备份。"
          }
        }
      }
    },
