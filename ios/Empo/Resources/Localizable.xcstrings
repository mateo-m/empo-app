    },
    "%@\n\nClose Empo from the app switcher, then reopen it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nSchließ Empo im App-Umschalter und öffne es wieder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nCierra Empo desde el selector de apps y vuelve a abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nFerme Empo depuis le sélecteur d'apps, puis rouvre-le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nChiudi Empo dall'App Switcher, poi riaprilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nAppスイッチャーでEmpoを閉じてから、もう一度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n앱 전환기에서 Empo를 닫은 뒤 다시 열어 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nFeche o Empo no seletor de apps e abra de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nЗакройте Empo в переключателе приложений и откройте снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n请在 App 切换器中关闭 Empo，然后重新打开。"
          }
        }
      }
    },
