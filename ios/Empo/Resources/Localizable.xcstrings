    "This game is missing the script file it needs to run. Download the game again, then import it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diesem Spiel fehlt die Skriptdatei, die es zum Laufen braucht. Lade das Spiel noch mal herunter und importiere es dann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A este juego le falta el archivo de scripts que necesita para funcionar. Descarga el juego de nuevo y vuelve a importarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque à ce jeu le fichier de script dont il a besoin. Télécharge le jeu de nouveau, puis importe-le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
