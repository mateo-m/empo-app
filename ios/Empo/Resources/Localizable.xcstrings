    "A backup file is missing from this location. Back up again to replace it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Speicherort fehlt eine Backup-Datei. Sichere erneut, um sie zu ersetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta un archivo de copia de seguridad en esta ubicación. Vuelve a hacer una copia de seguridad para reemplazarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier de copie de secours manque dans cet emplacement. Refais une copie de secours pour le remplacer."
