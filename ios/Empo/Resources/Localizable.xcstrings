    "System follows your device's appearance setting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„System“ folgt der Darstellung deines Geräts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema sigue la apariencia de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Système suit le réglage d'apparence de ton appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema segue l'aspetto del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システム」は端末の外観設定に合わせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템은 기기의 화면 모양 설정을 따라요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A opção Sistema segue a aparência do seu dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Система» следует оформлению вашего устройства."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“系统”会使用设备的外观设置。"
          }
        }
      }
    },
    "System uses your device's language when Empo has it, and English when it doesn't." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„System“ nutzt die Sprache deines Geräts, wenn Empo sie hat, sonst Englisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema usa el idioma de tu dispositivo si Empo lo tiene y, si no, inglés."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Système utilise la langue de ton appareil quand Empo l'a, et l'anglais sinon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema usa la lingua del dispositivo quando Empo ce l'ha, altrimenti l'inglese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システム」では、Empoが端末の言語に対応していればその言語を、対応していなければ英語を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템은 Empo가 기기 언어를 지원하면 그 언어를, 지원하지 않으면 영어를 사용해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A opção Sistema usa o idioma do seu dispositivo quando o Empo tem esse idioma, e inglês quando não tem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Система» использует язык устройства, если он есть в Empo, а если нет — английский."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“系统”会使用设备的语言；如果 Empo 没有这种语言，就用英语。"
          }
        }
      }
    },
