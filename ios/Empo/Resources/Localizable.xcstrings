    "Profiles live in Settings and work for any game." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile findest du in den Einstellungen. Sie funktionieren mit jedem Spiel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles están en Ajustes y sirven para cualquier juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils se trouvent dans Réglages et marchent pour tous les jeux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I profili sono nelle Impostazioni e funzionano con qualsiasi gioco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルは「設定」にあり、どのゲームでも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필은 설정에 있고, 어떤 게임에서든 쓸 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os perfis ficam em Ajustes e servem para qualquer jogo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профили хранятся в настройках и подходят для любой игры."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "方案保存在“设置”中，适用于任何游戏。"
          }
        }
      }
    },
    "Profiles live in Settings and work for any game. The profile also sets where the game sits on screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile findest du in den Einstellungen. Sie funktionieren mit jedem Spiel. Das Profil legt auch fest, wo das Spiel auf dem Bildschirm sitzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles están en Ajustes y sirven para cualquier juego. El perfil también decide dónde se coloca el juego en la pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils se trouvent dans Réglages et marchent pour tous les jeux. Le profil définit aussi la position du jeu à l'écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I profili sono nelle Impostazioni e funzionano con qualsiasi gioco. Il profilo decide anche dove sta il gioco sullo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルは「設定」にあり、どのゲームでも使えます。ゲーム画面の位置もプロファイルで決まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필은 설정에 있고, 어떤 게임에서든 쓸 수 있어요. 게임이 화면 어디에 놓일지도 프로필이 정해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os perfis ficam em Ajustes e servem para qualquer jogo. O perfil também define onde o jogo fica na tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профили хранятся в настройках и подходят для любой игры. Профиль также задаёт положение игры на экране."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "方案保存在“设置”中，适用于任何游戏。方案还决定游戏画面在屏幕上的位置。"
          }
        }
      }
    },
    "Progress you haven't saved will be lost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht gespeicherter Fortschritt geht verloren."
