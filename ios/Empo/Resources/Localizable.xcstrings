    "This layout is read-only. To make your own, duplicate it and edit the copy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Layout ist schreibgeschützt. Für ein eigenes duplizierst du es und bearbeitest die Kopie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este diseño es de solo lectura. Para hacer el tuyo, duplícalo y edita la copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette disposition est en lecture seule. Pour créer la tienne, duplique-la et modifie la copie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo layout è di sola lettura. Per farne uno tuo, duplicalo e modifica la copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このレイアウトは読み取り専用です。自分用にするには、複製してコピーを編集してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 레이아웃은 읽기 전용이에요. 내 레이아웃을 만들려면 복제한 뒤 사본을 편집하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este layout é só para leitura. Para criar o seu, duplique e edite a cópia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эту раскладку нельзя изменить. Чтобы сделать свою, продублируйте её и редактируйте копию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个布局是只读的。想要自己的布局，就复制一份再编辑副本。"
          }
        }
      }
    },
    "This stops importing \"%@\". If you were updating a game you already have, that copy stays as it is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das stoppt den Import von „%@“. Wenn du ein vorhandenes Spiel aktualisieren wolltest, bleibt diese Kopie, wie sie ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto detiene la importación de “%@”. Si estabas actualizando un juego que ya tenías, esa copia se queda como está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci arrête l'import de « %@ ». Si tu mettais à jour un jeu que tu as déjà, cette copie reste telle quelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Così interrompi l'importazione di «%@». Se stavi aggiornando un gioco che hai già, quella copia resta com'è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」のインポートを中止します。持っているゲームを更新していた場合、そのゲームは元のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 가져오기를 중지해요. 이미 있는 게임을 업데이트하던 중이었다면 기존 게임은 그대로 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso interrompe a importação de “%@”. Se você estava atualizando um jogo que já tem, essa cópia fica como está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импорт «%@» будет остановлен. Если вы обновляли уже установленную игру, она останется как была."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会停止导入“%@”。如果你是在更新已有的游戏，原来那份会保持不变。"
          }
        }
      }
    },
    "This works only in games that use a mouse." : {
      "localizations" : {
        "de" : {
