          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 백업을 쓰려면 최신 버전의 Empo가 필요해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este backup precisa de uma versão mais nova do Empo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этой резервной копии нужна более новая версия Empo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个备份需要更新版本的 Empo。"
          }
        }
      }
    },
    "This backup will fill %@'s saves and settings. Future backups of %@ will match this backup automatically." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Backup füllt die Spielstände und Einstellungen von %@. Künftige Backups von %@ werden diesem Backup automatisch zugeordnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de seguridad llenará las partidas y ajustes de %@. Las futuras copias de %@ se vincularán a esta automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette copie de secours remplira les sauvegardes et les réglages de %@. Les prochaines copies de secours de %@ seront associées automatiquement à celle-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo backup riempirà i salvataggi e le impostazioni di %@. I backup futuri di %@ verranno abbinati automaticamente a questo backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバックアップで%@のセーブデータと設定を埋めます。今後の%@のバックアップは、自動的にこのバックアップと結び付けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 백업으로 %@의 세이브와 설정을 채워요. 앞으로 %@의 백업은 자동으로 이 백업과 연결돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este backup vai preencher os saves e ajustes de %@. Os próximos backups de %@ vão se ligar a este backup automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта резервная копия заполнит сохранения и настройки «%@». Будущие резервные копии «%@» автоматически свяжутся с ней."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个备份会填入“%@”的存档和设置。以后“%@”的备份会自动与这个备份对应。"
          }
        }
      }
    },
    "This deletes \"%@\" from this Mac. Empo moves the saves it recognizes to Rescued Saves. Saves it doesn't recognize are deleted with the game. You can't undo this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das löscht „%@“ von diesem Mac. Empo verschiebt die Spielstände, die es erkennt, nach „Rescued Saves“. Spielstände, die es nicht erkennt, werden mit dem Spiel gelöscht. Du kannst das nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina “%@” de este Mac. Empo mueve a “Rescued Saves” las partidas guardadas que reconoce. Las que no reconoce se eliminan con el juego. No puedes deshacer esto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci supprime « %@ » de ce Mac. Empo déplace les sauvegardes qu'il reconnaît vers « Rescued Saves ». Celles qu'il ne reconnaît pas sont supprimées avec le jeu. Tu ne peux pas annuler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Così elimini «%@» da questo Mac. Empo sposta in «Rescued Saves» i salvataggi che riconosce. Quelli che non riconosce vengono eliminati con il gioco. Non puoi annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」をこのMacから削除します。Empoが認識できたセーブデータは「Rescued Saves」に移します。認識できなかったセーブデータはゲームと一緒に削除されます。元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 게임을 이 Mac에서 삭제해요. Empo가 알아본 세이브는 “Rescued Saves”로 옮겨요. 알아보지 못한 세이브는 게임과 함께 삭제돼요. 되돌릴 수 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso apaga “%@” deste Mac. O Empo move os saves que reconhece para “Rescued Saves”. Os saves que ele não reconhece são apagados junto com o jogo. Você não pode desfazer isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игра «%@» будет удалена с этого Mac. Сохранения, которые Empo распознает, он перенесёт в «Rescued Saves». Нераспознанные сохранения удалятся вместе с игрой. Это действие нельзя отменить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会从这台 Mac 上删除“%@”。Empo 会把它认得的存档移到“Rescued Saves”。认不出的存档会和游戏一起删除。此操作无法撤销。"
          }
        }
      }
    },
