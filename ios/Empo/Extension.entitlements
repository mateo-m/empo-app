<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	The entitlements of the extensions that the app embeds. They share
	the app group with the app, and they do not use iCloud.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(EMPO_APP_GROUP)</string>
	</array>
</dict>
</plist>
