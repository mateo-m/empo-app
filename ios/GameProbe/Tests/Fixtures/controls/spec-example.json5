{
  "$schema": "https://raw.githubusercontent.com/mateo-m/empo-app/main/docs/schemas/empo-controls.v1.schema.json",
  "version": 1,

  "touch": {
    // Portrait: game uses Z/X plus a run key and a quest log on Q.
    "portrait": {
      "dpad": { "x": 0.14, "y": 0.74, "size": 150, "opacity": 0.9 },
      "buttons": [
        { "label": "OK",   "key": "KeyZ",      "x": 0.88, "y": 0.80, "size": 68 },
        { "label": "Back", "key": "KeyX",      "x": 0.74, "y": 0.86, "size": 56 },
        { "label": "Run",  "key": "ShiftLeft", "x": 0.88, "y": 0.62, "size": 50, "opacity": 0.8 },
        { "label": "Log",  "key": "KeyQ",      "x": 0.06, "y": 0.06, "size": 44, "opacity": 0.5 }
      ],
      "actionButtons": [
        { "action": "$toggleFastForward", "x": 0.94, "y": 0.06, "size": 44, "opacity": 0.6 }
      ]
    },
    "landscape": {
      "dpad": { "x": 0.10, "y": 0.68 },
      "buttons": [
        { "label": "OK",   "key": "KeyZ", "x": 0.92, "y": 0.72, "size": 68 },
        { "label": "Back", "key": "KeyX", "x": 0.82, "y": 0.84, "size": 56 }
      ]
    }
  },

  "bindings": {
    // This game reads F5 for its fishing minigame.
    "y": "F5",
    "righttrigger": "ShiftLeft",

    // A small pad in keyboard mode: these keys are the face buttons,
    // so every binding above applies to it too.
    "KeyJ": "a",
    "KeyK": "b"
  }
}
